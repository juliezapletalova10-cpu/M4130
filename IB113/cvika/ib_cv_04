# a aby vracela True dojde-li opilec domu a False pokud ne.


def drunkman_simulator(size, steps, output=False):
    position = size // 2
    def print_state():
        print("home", end = " ")

        for place in range(size):
            if place == position:
                print("*", end = " ")
            else:
                print(".", end = " ")

        print("pub")

    if output:
        print_state()

    i = 0
    while i < steps and position != 0 and position != size:
        direction = randint(0, 1)

        if direction == 0:
            position -= 1
        else:
            position += 1

        if output:
            print_state()

        i += 1

    if output:
        if position == 0:
            print("Got home!")
        elif position == size:
            print("Got to the pub!")
        else:
            print("Fell asleep.")

    if position == 0:
        return True
    else:
        return False


drunkman_simulator(10, 10)


