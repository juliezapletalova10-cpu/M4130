from random import randint

def throw_till_odd() -> int:
    total_sum = 0
    n = 0
    count_throw = 0
    limmit = 3

    while n % 2 == 0 and count_throw < limmit:
        n = randint(1, 6)
        print(n, end = ", ")
        total_sum += n
        count_throw += 1

        if n % 2 != 0:
            break

        if count_throw >= limmit:
            print("Limit of throws reached.")
            break
    print()
    print(total_sum)
    print("Number of throws:", count_throw)

    mean_throw = total_sum / count_throw
    print("Mean value of throws:", mean_throw)

throw_till_odd()


def divisors_count(number):
    count = 0
    for i in range(1, number + 1):
        if number % i == 0:
            count += 1
    return count

print(divisors_count(12)) 

def is_prime(number):
    return divisors_count(number) == 2

print(is_prime(7))
print(is_prime(12))

def kth_prime(k):
    n = 0
    i = 1
    while n < k:
        i += 1
        if is_prime(i):
            n += 1
    return i

print(kth_prime(5))

def interval(count, lower, upper):
    if count <= 0:
        raise ValueError("count must be positive")
    if lower > upper:
        raise ValueError("lower must not exceed upper")

    numbers = [randint(lower, upper) for i in range(count)]
    print(*numbers)
    print("Minimum:", min(numbers))
    print("Maximum:", max(numbers))
    print("Average:", sum(numbers) / count)

interval(10, 5, 20)

